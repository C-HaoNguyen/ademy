DB_URL=jdbc:postgresql://localhost:5432/AcademicManagement
DB_USERNAME=postgres
DB_PASSWORD=postgres

SPRING_PROFILES_ACTIVE=local

# Cloudflare R2 (S3-compatible object storage) — required in all profiles
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=ademy-videos
R2_PUBLIC_BASE_URL=https://<public-bucket-domain>
R2_PRESIGN_EXPIRY_SECONDS=900

# Email — local profile uses Mailpit (docker-compose), prod profile uses Resend
MAIL_FROM_ADDRESS=no-reply@ademy.local
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
RESEND_API_KEY=changeme

# Payment gateways (Phase 21) — PAYMENT_MODE=mock (default) keeps /payments/checkout succeeding
# immediately with no credential needed. Set PAYMENT_MODE=live + fill in the credentials below to
# actually redirect Student to VNPay/Momo/Stripe and process real callbacks.
PAYMENT_MODE=mock

# FE domain — used to redirect the Student's browser back to /checkout/result after VNPay finishes
# (Phase 33). Not used by Momo/Stripe below (they point straight at the FE, see comments there).
FRONTEND_URL=http://localhost:5173

VNPAY_TMN_CODE=changeme
VNPAY_HASH_SECRET=changeme
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPay has no separate IPN URL config (unlike Momo/Stripe below) — this single URL is where VNPay
# sends the Student's browser back to. It must stay pointed at the backend (not the FE directly) so
# PaymentController.vnpayReturn can verify the signature + process the result, then it 302-redirects
# the browser to {FRONTEND_URL}/checkout/result?ref=... itself.
VNPAY_RETURN_URL=http://localhost:8080/payments/return/vnpay

MOMO_PARTNER_CODE=changeme
MOMO_ACCESS_KEY=changeme
MOMO_SECRET_KEY=changeme
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Browser-facing redirect (distinct from MOMO_IPN_URL below) — points straight at the FE result page.
# Momo appends its own orderId/resultCode/signature query params on redirect; the FE reads orderId.
MOMO_REDIRECT_URL=http://localhost:5173/checkout/result
# Server-to-server IPN — stays pointed at the backend, unaffected by Phase 33.
MOMO_IPN_URL=http://localhost:8080/payments/callback/momo

STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# Browser-facing redirect (Stripe webhook is configured separately on the Stripe dashboard, unaffected
# by these). StripeGateway appends ?ref=<transactionRef> itself before creating the session.
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/result
STRIPE_CANCEL_URL=http://localhost:5173/checkout/result
