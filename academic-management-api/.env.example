DB_URL=jdbc:postgresql://localhost:5432/AcademicManagement
DB_USERNAME=postgres
DB_PASSWORD=postgres

SPRING_PROFILES_ACTIVE=local

# Cloudflare R2 (S3-compatible object storage) — required in all profiles
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=ademy-videos
R2_PUBLIC_BASE_URL=https://<public-bucket-domain>
R2_PRESIGN_EXPIRY_SECONDS=900

# Email — local profile uses Mailpit (docker-compose), prod profile uses Resend
MAIL_FROM_ADDRESS=no-reply@ademy.local
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
RESEND_API_KEY=changeme

# Payment gateways (Phase 21) — PAYMENT_MODE=mock (default) keeps /payments/checkout succeeding
# immediately with no credential needed. Set PAYMENT_MODE=live + fill in the credentials below to
# actually redirect Student to VNPay/Momo/Stripe and process real callbacks.
PAYMENT_MODE=mock

VNPAY_TMN_CODE=changeme
VNPAY_HASH_SECRET=changeme
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payments/callback/vnpay

MOMO_PARTNER_CODE=changeme
MOMO_ACCESS_KEY=changeme
MOMO_SECRET_KEY=changeme
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:8080/payments/callback/momo
MOMO_IPN_URL=http://localhost:8080/payments/callback/momo

STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_SUCCESS_URL=http://localhost:8080/payments/callback/stripe
STRIPE_CANCEL_URL=http://localhost:8080/payments/callback/stripe
